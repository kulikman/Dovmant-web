# Absolute base URL — metadata, sitemap, robots, OG images.
NEXT_PUBLIC_SITE_URL=https://dovmant.example

# Flip to 1 once the matching files exist (see docs/shot-list.md).
NEXT_PUBLIC_HERO_VIDEO=0
NEXT_PUBLIC_FILM_VIDEO=0

# --- Form delivery (optional) -------------------------------------------------
# Without these the contact and data-room actions only log to the server.
# Email is sent through Resend's REST API; no SDK dependency is required.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Investor data room, phase 2 (optional) -----------------------------------
# Access requests are stored in Supabase when both are set.
# Apply supabase/migrations/0001_access_requests.sql first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
